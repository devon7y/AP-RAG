# ── AP-RAG ────────────────────────────────────────────────────────────────────
# OpenAI API key for gpt-5-mini (answer synthesis + chat-title + query condensing).
# Use a dedicated AP-RAG key so this site's spend is tracked/revocable on its own.
OPENAI_API_KEY=****

# The AP-RAG query server (LightRAG + Qdrant on the PC), reached over the Cloudflare
# Tunnel. Server-side only — never exposed to the browser.
APRAG_QUERY_URL=https://rag-api.devon7y.com

# Shared secret the query server requires on the public tunnel (set the same value as
# APRAG_API_KEY on the PC). Leave blank if the server has no key set.
APRAG_API_KEY=****

# Comma-separated allowlist of emails permitted to register / sign in. Locks the site to
# your account(s). Leave blank only for local dev (open registration).
AUTH_ALLOWED_EMAILS=devon7y@gmail.com

# Google sign-in (the default login when set; the button hides when unset). Create an
# OAuth 2.0 Web client in Google Cloud Console with redirect URI
#   https://aprag.devon7y.com/api/auth/callback/google
# (plus http://localhost:3000/api/auth/callback/google for dev). The AUTH_ALLOWED_EMAILS
# allowlist above still gates who may sign in — Google only authenticates.
AUTH_GOOGLE_ID=****
AUTH_GOOGLE_SECRET=****

# ── Template infrastructure ───────────────────────────────────────────────────
# Auth.js session secret — `openssl rand -base64 32`
AUTH_SECRET=****

# Postgres (chat history) — one-click Neon on Vercel, or any Postgres URL.
POSTGRES_URL=****

# Vercel Blob (file attachments).
BLOB_READ_WRITE_TOKEN=****

# Optional: Vercel Redis for resumable streams. Leave unset to disable.
REDIS_URL=
