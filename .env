### LightRAG Configuration for Westbury Papers RAG
### See LightRAG/env.example for the full list of options

###########################
### Server Configuration
###########################
HOST=0.0.0.0
PORT=9622
WEBUI_TITLE='Westbury Papers RAG'
WEBUI_DESCRIPTION="LightRAG knowledge graph over Westbury lab and related papers"

### Storage directories
INPUT_DIR=/Volumes/T7/Westbury papers
WORKING_DIR=/Users/devon7y/VS_Code/rag_testing/LightRAG/rag_storage_westbury

###########################
### Document Processing
###########################
ENABLE_LLM_CACHE_FOR_EXTRACT=true
SUMMARY_LANGUAGE=English

### Entity types: the ENTITY_TYPES env var is REMOVED in LightRAG >=1.5 (it fail-fasts
### if the var is merely present). The academic schema is now passed via
### addon_params['entity_types_guidance'] in pipeline/ingest.py (override there or via
### the ENTITY_TYPES_GUIDANCE env var).

### Chunk settings (1200 tokens is good for dense academic text)
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=150

###########################
### Query Configuration
###########################
ENABLE_LLM_CACHE=true
TOP_K=60
CHUNK_TOP_K=20
MAX_ENTITY_TOKENS=6000
MAX_RELATION_TOKENS=8000
MAX_TOTAL_TOKENS=30000

### Concurrency (tune based on API rate limits)
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2

###########################################################################
### LLM Configuration (HPC via SSH tunnel)
### Set up tunnel first: ssh -L 8000:localhost:8000 fir
###########################################################################
LLM_BINDING=openai
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_BINDING_HOST=http://localhost:8000/v1
LLM_BINDING_API_KEY=EMPTY
OPENAI_LLM_MAX_TOKENS=8000

#######################################################################################
### Embedding Configuration (OpenAI text-embedding-3-large)
#######################################################################################
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
EMBEDDING_SEND_DIM=false
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=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

############################
### Default Storage (JSON files — simple, no extra services needed)
############################
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
# NOTE: the LIGHTRAG_* storage keys above are read only by LightRAG's own server,
# NOT by the AP-RAG ingest path (the LightRAG constructor defaults are literals).
# The ingest pipeline (pipeline/ingest.py) reads these instead, set by the SLURM
# jobs (docs/INGEST_SCALING_BOTTLENECK.md):
#   KV_STORAGE / DOC_STATUS_STORAGE — e.g. RedisKVStorage / RedisDocStatusStorage
#   GRAPH_STORAGE                   — e.g. Neo4JStorage (+ NEO4J_URI/USERNAME/PASSWORD)
